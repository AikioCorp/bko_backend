datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ======================================================
// ENUMS DE DOMAINE STRICTS
// ======================================================

enum PodcastStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  UNLISTED
  ARCHIVED
  SUSPENDED
}

enum EpisodeStatus {
  DRAFT
  PENDING_REVIEW
  PROCESSING
  SCHEDULED
  PUBLISHED
  UNLISTED
  ARCHIVED
  FAILED
}

enum EpisodeType {
  FULL
  TRAILER
  BONUS
}

enum MediaAssetStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum UploadSessionStatus {
  PENDING
  UPLOADING
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  CANCELED
}

enum MarketStatus {
  DISABLED
  CATALOG_ONLY
  CREATOR_BETA
  ACTIVE
  SUSPENDED
}

enum CreatorMarketAccessStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PodcastOwnershipStatus {
  UNCLAIMED
  CLAIMED
  MANAGED
}

enum ClaimStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELED
}

enum VerificationMethod {
  EMAIL_DOMAIN
  WEBSITE
  RSS_CHALLENGE
  SOCIAL
  DOCUMENT
  MANUAL
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum CreationSource {
  CREATOR
  ADMIN
  RSS_IMPORT
  EXTERNAL_IMPORT
}

enum MediaType {
  AUDIO
  VIDEO
}

enum MediaSourceType {
  UPLOAD
  EXTERNAL
  RSS_FEED
}

enum ExternalProvider {
  YOUTUBE
  SPOTIFY
  APPLE_PODCASTS
  DEEZER
  SOUNDCLOUD
  VIMEO
  RSS
  WEBSITE
  OTHER
}

enum PlaybackMode {
  NATIVE
  EMBED
  EXTERNAL_REDIRECT
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum TranscriptType {
  ORIGINAL
  TRANSLATION
}

enum TranscriptStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

enum TranscriptSource {
  MANUAL
  UPLOAD
  AUTO_GENERATED
  IMPORTED
}

enum TranscriptVisibility {
  PRIVATE
  PUBLIC
}

enum ChapterSource {
  MANUAL
  IMPORTED
  AUTO_GENERATED
}

enum SuggestionType {
  TOPIC
  PERSON
  ORGANIZATION
  CHAPTER
  KEYWORD
  SUMMARY
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum EditorialSectionType {
  HERO
  PODCAST_ROW
  EPISODE_ROW
  PERSON_ROW
  COLLECTION_ROW
  TOPIC_ROW
}

enum EditorialSourceMode {
  MANUAL
  AUTOMATIC
  HYBRID
}

enum PodcastMemberRole {
  OWNER
  ADMIN
  EDITOR
  ANALYST
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  EDITOR
  ANALYST
}

enum PodcastPersonRole {
  HOST
  CO_HOST
  PRODUCER
  REGULAR_GUEST
  CONTRIBUTOR
}

enum EpisodePersonRole {
  HOST
  CO_HOST
  GUEST
  INTERVIEWER
  INTERVIEWEE
  PRODUCER
  SOUND_ENGINEER
}

enum ReportTargetType {
  PODCAST
  EPISODE
  PERSON
  COMMENT
  CREATOR_PROFILE
}

enum ReportReason {
  COPYRIGHT
  INAPPROPRIATE
  SPAM
  IMPERSONATION
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
  DISMISSED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ======================================================
// UTILISATEURS, AUTHENTIFICATION, SESSIONS & RBAC
// ======================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String?   @unique
  phoneNumber     String?   @unique
  passwordHash    String?
  fullName        String
  avatar          String?
  isVerified      Boolean   @default(false)
  isSuspended     Boolean   @default(false)
  suspendedAt     DateTime?
  suspendedReason String?

  // Jetons de vérification & OTP
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  otpCode                String?
  otpExpiresAt           DateTime?

  // System RBAC
  userRoles UserRole[]

  // Profiles & Relationships
  creatorProfile     CreatorProfile?
  podcastMemberships PodcastMember[]
  orgMemberships     OrganizationMember[]
  invitationsSent    PodcastInvitation[]  @relation("UserInvitationsSent")
  uploadSessions     UploadSession[]
  notifications      Notification[]

  // Media Assets owned / uploaded
  ownedAssets    MediaAsset[] @relation("MediaAssetOwner")
  uploadedAssets MediaAsset[] @relation("MediaAssetUploader")

  // Authentication & Devices
  sessions      Session[]
  devices       Device[]
  refreshTokens RefreshToken[]

  // User Activity & Interactions
  follows           PodcastFollow[]
  creatorFollows    CreatorFollow[]
  savedEpisodes     SavedEpisode[]
  playlists         Playlist[]
  playbackHistories PlaybackHistory[]
  claimsRequested   Claim[]
  reportsSubmitted  Report[]          @relation("UserReportsSubmitted")

  // Onboarding & Preferences
  languagePreferences    UserLanguagePreference[]
  topicPreferences       UserTopicPreference[]
  countryPreferences     UserCountryPreference[]
  notificationPreference NotificationPreference?
  auditLogs              AuditLog[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  PodcastRating PodcastRating[]
  EpisodeLike   EpisodeLike[]
  Comment       Comment[]
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  presetApplied   Boolean          @default(false)
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  description     String?
  rolePermissions RolePermission[]
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tokenHash])
}

model Device {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceFingerprint String?
  deviceType        String
  deviceName        String?
  osVersion         String?
  appVersion        String?
  lastActiveAt      DateTime       @default(now())
  sessions          Session[]
  pushTokens        PushToken[]
  refreshTokens     RefreshToken[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId])
}

model PushToken {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  token     String   @unique
  provider  String   @default("FCM")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String?
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tokenHash])
}

model CreatorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personId    String?  @unique
  person      Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  displayName String
  slug        String   @unique
  bio         String?  @db.Text
  avatar      String?
  banner      String?
  countryId   String?
  country     Country? @relation(fields: [countryId], references: [id])
  website     String?
  socialLinks Json?
  isVerified  Boolean  @default(false)

  followers    CreatorFollow[]
  marketAccess CreatorMarketAccess[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([slug])
}

model Market {
  id                     String                @id @default(cuid())
  countryId              String                @unique
  country                Country               @relation(fields: [countryId], references: [id], onDelete: Cascade)
  status                 MarketStatus          @default(DISABLED)
  discoveryEnabled       Boolean               @default(false)
  creatorSignupEnabled   Boolean               @default(false)
  podcastCreationEnabled Boolean               @default(false)
  publishingEnabled      Boolean               @default(false)
  uploadEnabled          Boolean               @default(false)
  rssImportEnabled       Boolean               @default(false)
  monetizationEnabled    Boolean               @default(false)
  isFeatured             Boolean               @default(false)
  launchDate             DateTime?
  creatorAccesses        CreatorMarketAccess[]
  editorialSections      EditorialSection[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}

model CreatorMarketAccess {
  id               String                    @id @default(cuid())
  creatorProfileId String
  creatorProfile   CreatorProfile            @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  marketId         String
  market           Market                    @relation(fields: [marketId], references: [id], onDelete: Cascade)
  status           CreatorMarketAccessStatus @default(PENDING)

  // Capability Overrides Individuels
  canCreatePodcast Boolean @default(false)
  canPublish       Boolean @default(false)
  canUpload        Boolean @default(false)
  canImportRss     Boolean @default(false)
  canMonetize      Boolean @default(false)

  grantedById String?
  grantedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([creatorProfileId, marketId])
}

model Person {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  photo       String?
  bio         String?  @db.Text
  countryId   String?
  country     Country? @relation(fields: [countryId], references: [id])
  city        String?
  website     String?
  socialLinks Json?

  creatorProfile     CreatorProfile?
  aliases            PersonAlias[]
  episodeAppearances EpisodePerson[]
  podcastAppearances PodcastPerson[]
  editorialItems     EditorialSectionItem[]
  collectionItems    CollectionItem[]
  transcriptSpeakers TranscriptSpeaker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model PersonAlias {
  id           String  @id @default(cuid())
  personId     String
  person       Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  alias        String
  languageCode String?

  @@index([alias])
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?  @db.Text
  website     String?
  countryId   String?
  country     Country? @relation(fields: [countryId], references: [id])

  members  OrganizationMember[]
  podcasts Podcast[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model OrganizationMember {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationMemberRole @default(EDITOR)

  @@unique([organizationId, userId])
}

model Podcast {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  description      String  @db.Text
  shortDescription String?
  cover            String
  banner           String?

  countryId String  @default("ML")
  country   Country @relation(fields: [countryId], references: [id])
  city      String?

  primaryLanguageCode String
  primaryLanguage     Language @relation("PodcastPrimaryLanguage", fields: [primaryLanguageCode], references: [code])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  status                 PodcastStatus          @default(PUBLISHED)
  reviewNote             String?                @db.Text
  reviewedAt             DateTime?
  reviewedById           String?
  ownershipStatus        PodcastOwnershipStatus @default(UNCLAIMED)
  creationSource         CreationSource         @default(ADMIN)
  managedByBamakoPodcast Boolean                @default(false)
  isOfficial             Boolean                @default(false)
  qualityScore           Int                    @default(70)

  website     String?
  redirectUrl String?

  secondaryLanguages PodcastLanguage[]
  alternateTitles    PodcastAlternateTitle[]
  ratings            PodcastRating[]

  categories       PodcastCategory[]
  topics           PodcastTopic[]
  seasons          Season[]
  episodes         Episode[]
  members          PodcastMember[]
  invitations      PodcastInvitation[]
  permanentPersons PodcastPerson[]
  externalSources  PodcastExternalSource[]
  followers        PodcastFollow[]
  rssFeed          RssFeed?
  claims           Claim[]
  editorialItems   EditorialSectionItem[]
  collectionItems  CollectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([countryId])
  @@index([status])
  @@index([ownershipStatus])
}

model PodcastAlternateTitle {
  id           String  @id @default(cuid())
  podcastId    String
  podcast      Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  title        String
  languageCode String?

  @@index([title])
}

model PodcastLanguage {
  podcastId    String
  podcast      Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  languageCode String
  language     Language @relation("PodcastSecondaryLanguages", fields: [languageCode], references: [code], onDelete: Cascade)

  @@id([podcastId, languageCode])
}

model PodcastMember {
  id        String            @id @default(cuid())
  podcastId String
  podcast   Podcast           @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PodcastMemberRole @default(EDITOR)

  @@unique([podcastId, userId])
}

model PodcastInvitation {
  id          String            @id @default(cuid())
  podcastId   String
  podcast     Podcast           @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  email       String
  role        PodcastMemberRole @default(EDITOR)
  tokenHash   String            @unique
  status      InvitationStatus  @default(PENDING)
  invitedById String
  invitedBy   User              @relation("UserInvitationsSent", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([podcastId])
  @@index([email])
}

model PodcastPerson {
  id        String            @id @default(cuid())
  podcastId String
  podcast   Podcast           @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  personId  String
  person    Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  role      PodcastPersonRole @default(HOST)

  @@unique([podcastId, personId])
}

model PodcastExternalSource {
  id         String           @id @default(cuid())
  podcastId  String
  podcast    Podcast          @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  provider   ExternalProvider
  externalId String?
  url        String
  isOfficial Boolean          @default(true)

  @@unique([podcastId, provider])
}

model Season {
  id          String    @id @default(cuid())
  podcastId   String
  podcast     Podcast   @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  number      Int
  title       String?
  description String?   @db.Text
  cover       String?
  episodes    Episode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([podcastId, number])
}

model Episode {
  allowComments Boolean @default(true)
  id            String  @id @default(cuid())
  podcastId     String
  podcast       Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  seasonId      String?
  season        Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  slug             String
  title            String
  description      String         @db.Text
  cover            String?
  episodeNumber    Int?
  durationSeconds  Int            @default(0)
  publishedAt      DateTime?
  status           EpisodeStatus  @default(PUBLISHED)
  reviewNote       String?        @db.Text
  reviewedAt       DateTime?
  reviewedById     String?
  creationSource   CreationSource @default(CREATOR)
  isManuallyEdited Boolean        @default(false)

  // Résumé court (cartes), type (complet / bande-annonce / bonus) et contenu explicite
  summary     String?     @db.Text
  episodeType EpisodeType @default(FULL)
  explicit    Boolean     @default(false)

  languageCode String?
  language     Language? @relation(fields: [languageCode], references: [code])

  mediaSources        MediaSource[]
  people              EpisodePerson[]
  topics              EpisodeTopic[]
  savedBy             SavedEpisode[]
  playlistItems       PlaylistItem[]
  histories           PlaybackHistory[]
  transcripts         Transcript[]
  chapters            EpisodeChapter[]
  suggestions         ContentSuggestion[]
  dailyStats          EpisodeDailyStats[]
  editorialItems      EditorialSectionItem[]
  collectionItems     CollectionItem[]
  rssImportedEpisodes RssImportedEpisode[]
  uploadSessions      UploadSession[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  EpisodeLike EpisodeLike[]
  Comment     Comment[]

  @@unique([podcastId, slug])
  @@index([publishedAt])
  @@index([status])
}

model UploadSession {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId        String?
  episode          Episode?            @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  mediaType        MediaType
  originalFilename String
  mimeType         String
  sizeBytes        BigInt
  storageKey       String
  status           UploadSessionStatus @default(PENDING)
  expiresAt        DateTime
  completedAt      DateTime?
  mediaAssetId     String?
  mediaAsset       MediaAsset?         @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model MediaSource {
  id           String            @id @default(cuid())
  episodeId    String
  episode      Episode           @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  type         MediaType
  sourceType   MediaSourceType
  provider     ExternalProvider?
  playbackMode PlaybackMode      @default(NATIVE)

  isPrimaryAudio Boolean @default(false)
  isPrimaryVideo Boolean @default(false)

  externalUrl String?
  embedUrl    String?
  externalId  String?

  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id])

  durationSeconds Int?
  mimeType        String?
  quality         String?

  // Diagnostic de santé du média
  status         String    @default("ACTIVE")
  lastCheckedAt  DateTime?
  lastHttpStatus Int?
  lastError      String?

  createdAt DateTime @default(now())

  @@index([episodeId])
}

model MediaAsset {
  id         String  @id @default(cuid())
  ownerId    String
  owner      User    @relation("MediaAssetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  uploaderId String?
  uploader   User?   @relation("MediaAssetUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  storageProvider String @default("R2")
  bucket          String
  key             String
  mimeType        String
  sizeBytes       BigInt

  width           Int?
  height          Int?
  codec           String?
  bitrateKbps     Int?
  durationSeconds Int?
  sampleRateHz    Int?
  channels        Int?

  status         MediaAssetStatus @default(PROCESSING)
  mediaSources   MediaSource[]
  uploadSessions UploadSession[]

  createdAt DateTime @default(now())
}

model Transcript {
  id           String               @id @default(cuid())
  episodeId    String
  episode      Episode              @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  languageCode String
  language     Language             @relation(fields: [languageCode], references: [code])
  type         TranscriptType       @default(ORIGINAL)
  status       TranscriptStatus     @default(READY)
  source       TranscriptSource     @default(MANUAL)
  visibility   TranscriptVisibility @default(PUBLIC)
  provider     String?
  isPrimary    Boolean              @default(true)
  isReviewed   Boolean              @default(false)
  lastEditedBy String?
  reviewedBy   String?
  reviewedAt   DateTime?
  completedAt  DateTime?
  errorMessage String?

  sourceTranscriptId String?
  sourceTranscript   Transcript?  @relation("TranscriptTranslations", fields: [sourceTranscriptId], references: [id], onDelete: SetNull)
  translations       Transcript[] @relation("TranscriptTranslations")

  segments TranscriptSegment[]
  speakers TranscriptSpeaker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([episodeId])
  @@index([languageCode])
  @@index([status])
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  startTimeMs  Int
  endTimeMs    Int
  text         String     @db.Text
  speakerId    String?
  speakerLabel String?
  confidence   Float?

  createdAt DateTime @default(now())

  @@index([transcriptId])
  @@index([startTimeMs])
}

model TranscriptSpeaker {
  id           String     @id @default(cuid())
  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  label        String
  displayName  String?
  personId     String?
  person       Person?    @relation(fields: [personId], references: [id], onDelete: SetNull)
  confidence   Float?

  @@unique([transcriptId, label])
}

model EpisodeChapter {
  id          String        @id @default(cuid())
  episodeId   String
  episode     Episode       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  position    Int           @default(0)
  title       String
  description String?       @db.Text
  startTimeMs Int
  endTimeMs   Int?
  source      ChapterSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([episodeId])
}

model ContentSuggestion {
  id         String           @id @default(cuid())
  episodeId  String
  episode    Episode          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  type       SuggestionType
  status     SuggestionStatus @default(PENDING)
  confidence Float?
  source     String           @default("AI_ENRICHMENT")
  payload    Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([episodeId, status])
}

model RssFeed {
  id                   String    @id @default(cuid())
  podcastId            String    @unique
  podcast              Podcast   @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  url                  String    @unique
  etag                 String?
  lastModified         String?
  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  nextSyncAt           DateTime?
  syncStatus           String    @default("IDLE")
  errorMessage         String?

  // Synchronisation automatique (planifiée par le worker via nextSyncAt) et réglages d'import.
  // importSettings : { importScope, newEpisodesTreatment, keepManualEdits } — null = comportement historique.
  syncEnabled    Boolean @default(true)
  importSettings Json?
  // Auteur déclaré par le flux d'origine (conservé pour les émissions tierces).
  sourceAuthor   String?

  syncRuns         RssSyncRun[]
  importedEpisodes RssImportedEpisode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([url])
  @@index([syncEnabled, nextSyncAt])
}

model RssSyncRun {
  id                 String    @id @default(cuid())
  rssFeedId          String
  rssFeed            RssFeed   @relation(fields: [rssFeedId], references: [id], onDelete: Cascade)
  status             String
  episodesDiscovered Int       @default(0)
  episodesImported   Int       @default(0)
  episodesUpdated    Int       @default(0)
  episodesSkipped    Int       @default(0)
  episodesFailed     Int       @default(0)
  errorMessage       String?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
}

model RssImportedEpisode {
  id                String    @id @default(cuid())
  rssFeedId         String
  rssFeed           RssFeed   @relation(fields: [rssFeedId], references: [id], onDelete: Cascade)
  guid              String
  enclosureUrl      String
  enclosureType     String?
  enclosureLength   BigInt?
  sourcePublishedAt DateTime?
  sourceUpdatedAt   DateTime?
  sourceHash        String?

  localEpisodeId String?
  localEpisode   Episode? @relation(fields: [localEpisodeId], references: [id], onDelete: SetNull)

  @@unique([rssFeedId, guid])
}

model EditorialSection {
  id         String               @id @default(cuid())
  title      String
  slug       String               @unique
  subtitle   String?
  type       EditorialSectionType
  sourceMode EditorialSourceMode  @default(MANUAL)
  position   Int                  @default(0)
  isActive   Boolean              @default(true)

  marketId String?
  market   Market?   @relation(fields: [marketId], references: [id], onDelete: SetNull)
  startsAt DateTime?
  endsAt   DateTime?

  items     EditorialSectionItem[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model EditorialSectionItem {
  id           String           @id @default(cuid())
  sectionId    String
  section      EditorialSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  podcastId    String?
  podcast      Podcast?         @relation(fields: [podcastId], references: [id], onDelete: SetNull)
  episodeId    String?
  episode      Episode?         @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  personId     String?
  person       Person?          @relation(fields: [personId], references: [id], onDelete: SetNull)
  collectionId String?
  collection   Collection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  topicId      String?
  topic        Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  position     Int              @default(0)
}

model Collection {
  id             String                 @id @default(cuid())
  title          String
  slug           String                 @unique
  description    String?
  cover          String?
  isFeatured     Boolean                @default(false)
  items          CollectionItem[]
  editorialItems EditorialSectionItem[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  podcastId    String?
  podcast      Podcast?   @relation(fields: [podcastId], references: [id], onDelete: SetNull)
  episodeId    String?
  episode      Episode?   @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  personId     String?
  person       Person?    @relation(fields: [personId], references: [id], onDelete: SetNull)
  topicId      String?
  topic        Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  position     Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EpisodeDailyStats {
  id                   String   @id @default(cuid())
  episodeId            String
  episode              Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  date                 DateTime @db.Date
  plays                Int      @default(0)
  qualifiedPlays       Int      @default(0)
  completedPlays       Int      @default(0)
  totalPlayTimeSeconds BigInt   @default(0)
  uniqueListeners      Int      @default(0)

  @@unique([episodeId, date])
  @@index([date])
}

model JobQueueItem {
  id          String    @id @default(cuid())
  queueName   String
  jobType     String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([queueName, status])
}

model SlugRedirect {
  id         String   @id @default(cuid())
  entityType String
  oldSlug    String
  newSlug    String
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([entityType, oldSlug])
  @@index([oldSlug])
}

model Country {
  id              String                  @id
  name            String
  code            String                  @unique
  flagEmoji       String?
  market          Market?
  podcasts        Podcast[]
  creators        CreatorProfile[]
  persons         Person[]
  organizations   Organization[]
  userPreferences UserCountryPreference[]
}

model Language {
  code              String                   @id
  name              String
  nativeName        String
  isActive          Boolean                  @default(true)
  primaryPodcasts   Podcast[]                @relation("PodcastPrimaryLanguage")
  secondaryPodcasts PodcastLanguage[]        @relation("PodcastSecondaryLanguages")
  episodes          Episode[]
  transcripts       Transcript[]
  userPreferences   UserLanguagePreference[]
}

model Category {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String?
  icon        String?
  isActive    Boolean           @default(true)
  podcasts    PodcastCategory[]
}

model Topic {
  id              String                 @id @default(cuid())
  slug            String                 @unique
  name            String
  description     String?
  aliases         TopicAlias[]
  podcasts        PodcastTopic[]
  episodes        EpisodeTopic[]
  editorialItems  EditorialSectionItem[]
  collectionItems CollectionItem[]
  userPreferences UserTopicPreference[]
}

model TopicAlias {
  id           String  @id @default(cuid())
  topicId      String
  topic        Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  alias        String
  languageCode String?

  @@index([alias])
}

model UserLanguagePreference {
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageCode String
  language     Language @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@id([userId, languageCode])
}

model UserTopicPreference {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
}

model UserCountryPreference {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@id([userId, countryId])
}

model NotificationPreference {
  userId              String  @id
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNewEpisodes    Boolean @default(true)
  pushNewEpisodes     Boolean @default(true)
  editorialHighlights Boolean @default(true)
}

model PodcastCategory {
  podcastId  String
  podcast    Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([podcastId, categoryId])
}

model PodcastTopic {
  podcastId String
  podcast   Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([podcastId, topicId])
}

model EpisodeTopic {
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([episodeId, topicId])
}

model EpisodePerson {
  episodeId String
  episode   Episode           @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  personId  String
  person    Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  role      EpisodePersonRole @default(GUEST)

  @@id([episodeId, personId])
}

model PodcastFollow {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcastId String
  podcast   Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, podcastId])
}

model CreatorFollow {
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@id([userId, creatorProfileId])
}

model SavedEpisode {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, episodeId])
}

model Playlist {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  visibility  Visibility     @default(PUBLIC)
  items       PlaylistItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  episodeId  String
  episode    Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  position   Int
  addedAt    DateTime @default(now())
}

model PlaybackHistory {
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId       String
  episode         Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  positionSeconds Int      @default(0)
  completed       Boolean  @default(false)
  lastPlayedAt    DateTime @default(now())

  @@id([userId, episodeId])
}

model Claim {
  id                 String             @id @default(cuid())
  podcastId          String
  podcast            Podcast            @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  proofDescription   String             @db.Text
  proofDocumentUrl   String?
  verificationMethod VerificationMethod @default(MANUAL)
  status             ClaimStatus        @default(PENDING)
  reviewNotes        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([podcastId])
  @@index([userId])
  @@index([status])
}

model Report {
  id          String           @id @default(cuid())
  reporterId  String?
  reporter    User?            @relation("UserReportsSubmitted", fields: [reporterId], references: [id], onDelete: SetNull)
  targetType  ReportTargetType
  targetId    String
  reason      ReportReason
  description String?
  status      ReportStatus     @default(OPEN)
  createdAt   DateTime         @default(now())

  // Traitement par la modération
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?   @db.Text

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String
  entityType    String
  entityId      String
  previousState Json?
  newState      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
}

// Notifications dans l'application (cloche du site, du studio et de la console).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // ex. EPISODE_APPROVED, EPISODE_REJECTED, NEW_EPISODE, MEDIA_FAILED…
  title     String
  body      String?   @db.Text
  link      String? // chemin interne du site (ex. /studio/episodes/xxx/edit)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// ======================================================
// TARIFS & STUDIO (OFFRES ET SERVICES)
// ======================================================

enum OfferType {
  PACKAGE
  SERVICE
}

model StudioOffer {
  id          String    @id @default(cuid())
  type        OfferType
  name        String
  price       String
  unit        String?
  description String    @db.Text
  features    String[]
  isPopular   Boolean   @default(false)
  iconName    String?
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// --- NOUVEAUX MODÈLES: LIKES, COMMENTAIRES & NOTES ---

model PodcastRating {
  id        String   @id @default(cuid())
  podcastId String
  podcast   Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int // 1 to 5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([podcastId, userId])
}

model EpisodeLike {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([episodeId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  isVisible Boolean  @default(true) // For moderation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
