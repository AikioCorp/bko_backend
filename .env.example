PORT=8080
NODE_ENV=development
SEED_MODE=reference
ALLOWED_ORIGINS=http://localhost:3000,https://bamakopodcast.studio

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host/neondb?sslmode=require"

# OpenAI Whisper API Key
OPENAI_API_KEY="sk-..."
TRANSCRIPTION_PROVIDER="openai"

# Feature Flags
ENABLE_UPLOADS=true
ENABLE_RSS=true
ENABLE_TRANSCRIPTION=true

# JWT Auth Secrets (Generer des cles cryptographiques fortes pour la prod)
JWT_SECRET="your-production-access-jwt-secret"
JWT_REFRESH_SECRET="your-production-refresh-jwt-secret"

# Storage Cloudflare R2 / S3
STORAGE_PROVIDER="R2"
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="bamako-podcast-media"
R2_PUBLIC_URL="https://media.bamakopodcast.studio"
