PORT=8080
NODE_ENV=development
SEED_MODE=reference
ALLOWED_ORIGINS=http://localhost:3000,https://bamakopodcast.studio

# Database PostgreSQL (VPS / Docker ou Local)
DATABASE_URL="postgresql://bko_admin:votre_mot_de_passe@localhost:5432/bamako_podcast?schema=public"

# OpenAI Whisper API Key
OPENAI_API_KEY="sk-..."
TRANSCRIPTION_PROVIDER="openai"

# Feature Flags
ENABLE_UPLOADS=true
ENABLE_RSS=true
ENABLE_TRANSCRIPTION=true
# Validation préalable des contenus des créateurs (hors équipe et créateurs de confiance)
REQUIRE_CONTENT_REVIEW=false

# URL publique du site web (liens des emails : invitation, réinitialisation de mot de passe)
APP_URL=http://localhost:3000

# Emails : smtp | resend | console (console = affichage dans le terminal, développement uniquement).
# Si MAIL_PROVIDER est vide : smtp si SMTP_HOST est défini, sinon resend si RESEND_API_KEY est défini, sinon console.
MAIL_PROVIDER=
MAIL_FROM="Bamako Podcast <no-reply@bamakopodcast.studio>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
REQUIRE_VERIFIED_LOGIN=false

# JWT Auth Secrets (Generer des cles cryptographiques fortes pour la prod)
JWT_SECRET="your-production-access-jwt-secret"
JWT_REFRESH_SECRET="your-production-refresh-jwt-secret"

# Storage Cloudflare R2 / S3
STORAGE_PROVIDER="R2"
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_MEDIA="bamako-podcast-media"
R2_BUCKET_NAME="bamako-podcast-media"
R2_PUBLIC_BASE_URL="https://media.bamakopodcast.studio"
R2_PUBLIC_URL="https://media.bamakopodcast.studio"
